# Copy to jarvis-local.yml (git-ignored) in the directory you start Jarvis from.
spring:
  ai:
    anthropic:
      api-key: sk-ant-...
      # Only for keys not scoped to a workspace (the API answers 400 asking for this header)
      # custom-headers:
      #   anthropic-workspace-id: wrkspc_...
    openai:
      api-key: sk-...

# The GitHub MCP server reads GITHUB_TOKEN (fine-grained token) from the environment or from .env

jarvis:
  providers:
    enabled: anthropic,openai,ollama
    default-provider: anthropic
  voice:
    # local (Speaches, default) | openai | browser | off, independently for each direction
    stt: local
    tts: local
    openai:
      api-key: sk-...   # only needed for stt/tts = openai
