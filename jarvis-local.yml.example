# Copy to jarvis-local.yml (git-ignored) in the directory you start Jarvis from. Development only.
# Keys, providers, voice, folders and mail are not here: the wizard and Settings save them in the database.
# This file is for what Settings does not cover, for example:

spring:
  ai:
    anthropic:
      chat:
        model: claude-sonnet-5-5

jarvis:
  providers:
    default-provider: anthropic
  voice:
    local:
      base-url: http://localhost:8000/v1/
